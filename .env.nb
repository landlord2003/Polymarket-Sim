# ============================================================
# NB 省实盘部署模板（Polymarket-Sim）
# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 排除，永不入库。
# 适用：加拿大 New Brunswick 等开放省，物理 IP 落 CA 开放省、无 KYC、可实盘。
# ============================================================

# ---- 关停 / kill switch 鉴权（务必改成随机长串，勿留弱默认）----
SHUTDOWN_TOKEN=

# ---- 钉钉告警（kill switch 触发 / 周期报告推送；建议配置）----
# DINGTALK_WEBHOOK=
# DINGTALK_SECRET=

# ---- NB 模式开关 ----
# 0 = 关闭合规过滤（NB 无合规风险，可交易所有市场）；中国部署请保持 1
COMPLIANCE_FILTER=0

# ---- 实盘开关（先 0 跑 ≥1 周模拟观察，再改 1 小资金实盘）----
LIVE_MODE=0                  # 0=DRY_RUN 不真发单；1=真发单（必须同时填 PM_BOT_PK）
PM_BOT_PK=                   # 钱包私钥（仅 env，绝不写代码/提交）；LIVE_MODE=1 时必须填

# ---- CLOB 连接 ----
CLOB_HOST=https://clob.polymarket.com
CLOB_CHAIN_ID=137            # Polygon Mainnet

# ---- 金融风控（P3-4，单位 USDC）----
MAX_POS_PER_MARKET=200       # 单市场最大仓位
MAX_TOTAL_POS=2000           # 总仓位上限
DAILY_LOSS_LIMIT=100         # 日亏损限额（触限即停一切新单）
RISK_PERSIST=1               # 风控状态落盘 data/risk_state.json，跨重启保留

# ---- 做市 / 模拟参数（实盘沿用）----
SIM_MODE=inv
FILL_BASE=0.30
PRICE_REFRESH_SEC=150
AUTO_REPORT_MIN=30

# ---- WebSocket（P3-2，实盘低延迟盘口；需 pip install websockets）----
CLOB_WS_URI=wss://ws-subscriptions-clob.polymarket.com/ws/market
WS_RECONNECT_BASE=2
WS_RECONNECT_MAX=60
