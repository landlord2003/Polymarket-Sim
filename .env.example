# ===== 钉钉机器人（自定义 Webhook + 加签）=====
# 从你现有 D:\WorkBuddy\output\dingtalk_notify.py 复制这两个值
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=你的token
DINGTALK_SECRET=你的SEC密钥

# ===== （可选）企业微信机器人 Webhook =====
WECOM_WEBHOOK=

# ===== 加密模拟盘（CCXT / Freqtrade testnet，零资金验证）=====
# 默认 dry_run=true 永不真实下单；testnet=true 走 Binance 测试网
CRYPTO_SYMBOL=BTC/USDT
CRYPTO_TIMEFRAME=1m
CRYPTO_TESTNET=true
CRYPTO_DRYRUN=true
# 仅当 dry_run=false + testnet=true 时填（Binance Testnet 申请：https://testnet.binance.vision/）
CRYPTO_API_KEY=
CRYPTO_API_SECRET=
# 是否把加密信号推送钉钉
CRYPTO_PUSH=false
CRYPTO_EQUITY=10000
